# GitHub API — Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: read:user, public_repo
GITHUB_TOKEN=ghp_your_token_here

# Your GitHub username
GITHUB_USERNAME=YoniLevy10

# Public GitHub username (used in client-side image URLs)
NEXT_PUBLIC_GITHUB_USERNAME=YoniLevy10

# Your site URL (used for absolute OG / canonical URLs)
NEXT_PUBLIC_SITE_URL=https://project-g7xfs.vercel.app

# Optional: GitHub Webhook secret for instant revalidation
# WEBHOOK_SECRET=your_random_secret_here

# ── Contact form (Resend — required for submissions) ─────────────────
# https://resend.com — without RESEND_API_KEY the form returns an error (never fake "Sent")
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO=OpsBrain1@gmail.com
# Optional verified sender (defaults to Resend onboarding address in dev)
# CONTACT_FROM_EMAIL=OpsBrain <onboarding@resend.dev>

# Optional GA4 measurement ID (do not invent — leave unset until you have one)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
